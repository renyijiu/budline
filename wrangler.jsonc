// Cloudflare Workers static assets: `pnpm run deploy` builds and uploads dist/.
{
  "name": "budline",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "budline.renyijiu.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
